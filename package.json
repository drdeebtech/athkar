    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4",
